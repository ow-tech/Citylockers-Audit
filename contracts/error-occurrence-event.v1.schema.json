        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "metadata": {
      "$ref": "#/$defs/ErrorOccurrence"
    },
    "source_kind": {
      "const": "explicit_error",
      "default": "explicit_error",
      "title": "Source Kind",
      "type": "string"
    }
  },
  "required": [
