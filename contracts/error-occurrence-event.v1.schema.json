  "additionalProperties": false,
  "description": "Versioned producer contract for one explicit error occurrence.\n\nThe API continues to accept the broader ``AuditEvent`` union.  Producers use\nthis constrained form so their generated schema cannot accidentally describe\nan authoritative-source event or omit occurrence identity.",
  "properties": {
    "event_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Event Id"
    },
    "system_code": {
      "enum": [
        "CL",
        "KH",
        "PA",
        "BR",
        "KS",
        "AU"
      ],
      "title": "System Code",
      "type": "string"
    },
    "event_type": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Event Type",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "trace_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    },
    "operation_id": {
