# The host port remains loopback-only; cloudflared reaches audit-api on Docker's audit-tunnel network.
AUDIT_HOST=0.0.0.0
AUDIT_PORT=8080
AUDIT_BIND_ADDRESS=127.0.0.1
AUDIT_POSTGRES_DB=audit
AUDIT_POSTGRES_USER=audit
AUDIT_POSTGRES_PASSWORD=replace-with-secret
AUDIT_DATABASE_URL=postgresql://audit:replace-with-secret@postgres:5432/audit
AUDIT_INGEST_TOKEN=replace-with-write-only-secret
AUDIT_QUERY_TOKEN=replace-with-read-only-secret
AUDIT_VERSION=replace-with-release-version
AUDIT_COMMIT_SHA=replace-with-commit-sha

# Backup operators may override these paths/limits. Keep the recipient and remote script secret/operator-managed.
AUDIT_BACKUP_DIR=/var/backups/citylockers-audit/daily
AUDIT_BACKUP_DAILY_RETENTION=14
AUDIT_BACKUP_WEEKLY_DIR=/var/backups/citylockers-audit/weekly
AUDIT_BACKUP_WEEKLY_RETENTION=12
AUDIT_BACKUP_AGE_RECIPIENT=age1replace-with-operator-recipient
# Optional executable, invoked with one encrypted artifact path; omit entirely when no remote-copy seam is configured.
# AUDIT_BACKUP_REMOTE_SCRIPT=/usr/local/sbin/citylockers-audit-copy-backup

# Required only when starting: docker compose --profile cloudflared up -d cloudflared
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
